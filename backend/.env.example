ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Local dev default (a SQLite file on disk) — leave DATABASE_URL unset to use this.
# DATABASE_URL=sqlite:///./data/league.db

# Production (Supabase): use the "Transaction" pooler connection string from
# Project Settings -> Database -> Connection string. Required on Vercel since the
# backend runs as serverless functions with no local disk to put a SQLite file on.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
